            }
        },
        "agenciafmd/filament-partners": {
            "type": "path",
            "url": "packages/agenciafmd/filament-partners",
            "options": {
                "symlink": true
            }
        },
        "agenciafmd/filament-postal": {
            "type": "path",
            "url": "packages/agenciafmd/filament-postal",
            "options": {
                "symlink": true
            }
        },
        "agenciafmd/filament-redirects": {
            "type": "path",
            "url": "packages/agenciafmd/filament-redirects",
            "options": {
