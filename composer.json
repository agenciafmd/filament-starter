{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "agenciafmd/filament-starter",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework",
        "filament",
        "starter",
        "agenciafmd"
    ],
    "license": "MIT",
    "repositories": {
        "agenciafmd/frontend": {
            "type": "path",
