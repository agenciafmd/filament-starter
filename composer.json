    "require": {
        "php": "^8.4",
        "agenciafmd/filament-admix": "*",
        "agenciafmd/filament-articles": "*",
        "agenciafmd/filament-banners": "*",
        "agenciafmd/filament-big-numbers": "*",
        "agenciafmd/filament-faqs": "*",
        "agenciafmd/filament-http-logs": "*",
        "agenciafmd/filament-instagram": "*",
        "agenciafmd/filament-leads": "*",
        "agenciafmd/filament-partners": "*",
        "agenciafmd/filament-postal": "*",
        "agenciafmd/filament-redirects": "*",
        "agenciafmd/filament-testimonials": "*",
        "agenciafmd/frontend": "*",
        "agenciafmd/laravel-rdstation": "*",
        "agenciafmd/laravel-sitemap": "*",
        "agenciafmd/laravel-social-meta": "*",
        "agenciafmd/laravel-support": "*",
        "agenciafmd/laravel-turbo": "*",
        "filament/filament": "^5.9.0",
        "laravel/framework": "^13.35.0",
        "laravel/tinker": "^v3.0.2"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7.0",
        "driftingly/rector-laravel": "^2.6.2",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.12.3",
        "laravel/boost": "^2.10.2",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.68",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3.0",
        "pestphp/pest-plugin-browser": "^5.1.2",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-rector": "^5.0.5",
        "pestphp/pest-plugin-type-coverage": "^5.0.2",
        "phpstan/extension-installer": "^1.4.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade",
            "@php artisan filament:optimize"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan vendor:publish --tag=filament-postal:images --ansi --force",
            "@php artisan vendor:publish --tag=filament-admix:theme --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:models --dir='packages/agenciafmd/*/src/Models' --nowrite",
            "@php artisan clear",
            "@php artisan filament:optimize-clear",
            "@update:requirements",
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan key:generate --ansi",
            "./vendor/bin/sail up -d --wait",
            "./vendor/bin/sail artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "update:requirements": [
            "composer bump",
            "npx npm-check-updates -u"
        ],
        "lint": [
            "rector",
            "pint --parallel --blade",
            "npm run lint"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:lint": [
            "rector --dry-run",
            "pint --parallel --blade --test",
            "npm run test:lint"
        ],
        "test:unit": "pest --parallel --tia",
        "test:unit:baseline": "pest --parallel --tia --fresh",
        "test:types": "phpstan",
        "test": [
            "@php artisan config:clear --ansi",
            "@test:type-coverage",
            "@test:unit",
            "@test:lint",
            "@test:types"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
