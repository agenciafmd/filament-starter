includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - packages
        - public
        - routes

    excludePaths:
        - packages/*/*/tests/*
        - */resources/boost/*

    level: max

    parseModelCastsMethod: true

    tmpDir: /tmp/phpstan

    configDirectories:
        - config
        - packages/*/*/config

    databaseMigrationsPath:
        - database/migrations
        - packages/*/*/database/migrations