includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - public
        - routes
        - packages/agenciafmd/laravel-rdstation/src


    level: max

    tmpDir: /tmp/phpstan

    configDirectories:
        - config
        - packages/*/*/src/config