includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - packages
        - public
        - routes

    excludePaths:
        - packages/*/*/tests/*

    level: max

    parseModelCastsMethod: true

    tmpDir: /tmp/phpstan

    configDirectories:
        - config
        - packages/*/*/config

    ignoreErrors:
        -
            identifier: trait.unused
            path: packages/agenciafmd/laravel-support/src/Traits/SeederSupport.php

    databaseMigrationsPath:
        - database/migrations
        - packages/*/*/database/migrations