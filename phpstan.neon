includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - packages
        - public
        - routes

    excludePaths:
        analyseAndScan:
            - packages/*/*/tests/*
            - */resources/boost/*
        # Clones locais dos pacotes, que são analisados nos próprios repositórios: ficam fora da análise, mas
        # continuam no scan, para que o config e o frontend, que referenciam as classes deles, sigam resolvendo.
        analyse:
            - packages/agenciafmd/filament-*
            - packages/agenciafmd/laravel-*

    level: max

    parseModelCastsMethod: true

    tmpDir: /tmp/phpstan

    configDirectories:
        - config
        - packages/*/*/config

    databaseMigrationsPath:
        - database/migrations
        - packages/*/*/database/migrations