includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - packages
        - public
        - routes

    excludePaths:
        analyseAndScan:
            - packages/*/*/tests/*
            - */resources/boost/*
        # Clones locais dos pacotes, que são analisados nos próprios repositórios: ficam fora da análise, mas
        # continuam no scan, para que o config e o frontend, que referenciam as classes deles, sigam resolvendo.
        analyse:
            - packages/agenciafmd/filament-*
            - packages/agenciafmd/laravel-*

    level: max

    # Plugins e models de pacotes opcionais: quando o pacote não está instalado (ex.: no CI), a classe não existe.
    # O admix ignora os plugins ausentes e o PageCacheEventSubscriber só usa o nome da classe nos eventos.
    ignoreErrors:
        -
            identifier: class.notFound
            paths:
                - config/filament-admix.php
                - packages/agenciafmd/frontend/src/Listeners/PageCacheEventSubscriber.php
            reportUnmatched: false
        -
            identifier: argument.type
            message: '#expects class-string<Illuminate\\Database\\Eloquent\\Model>, string given#'
            path: packages/agenciafmd/frontend/src/Listeners/PageCacheEventSubscriber.php
            reportUnmatched: false

    parseModelCastsMethod: true

    tmpDir: /tmp/phpstan

    configDirectories:
        - config
        - packages/*/*/config

    databaseMigrationsPath:
        - database/migrations
        - packages/*/*/database/migrations