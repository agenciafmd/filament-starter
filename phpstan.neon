includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - packages
        - public
        - routes

    excludePaths:
        - packages/*/*/tests/*
        - */resources/boost/*

    level: max

    parseModelCastsMethod: true

    tmpDir: /tmp/phpstan

    configDirectories:
        - config
        - packages/*/*/config

    ignoreErrors:
        -
            identifier: trait.unused
            paths:
                - packages/agenciafmd/laravel-support/src/Traits/SeederSupport.php
                - packages/agenciafmd/filament-admix/src/Testing/WithTenancy.php
                - packages/agenciafmd/filament-admix/src/Traits/BelongsToOrganization.php

    databaseMigrationsPath:
        - database/migrations
        - packages/*/*/database/migrations