{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "npm run webp && vite",
        "build": "npm run webp && vite build && npm run pwa",
        "webp": "node resources/js/utilities/webp.js",
        "pwa": "node resources/js/utilities/create-manifest.js",
        "lint": "prettier --write resources/",
        "test:lint": "prettier --check resources/",
        "build:filament": "vite build --config vite.admix.config.js",
        "postinstall": "playwright install chromium"
    },
    "devDependencies": {
        "@erbelion/vite-plugin-laravel-purgecss": "^0.4.8",
        "@tailwindcss/vite": "^4.3.3",
        "concurrently": "^10.0.6",
        "laravel-vite-plugin": "^3.2.0",
        "npm-check-updates": "^23.1.1",
        "playwright": "^1.64.1",
        "postcss-prefix-custom-properties": "^0.1.0",
        "prettier": "^3.9.10",
        "prettier-plugin-blade": "^3.3.3",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rollup-plugin-critical": "^1.0.18",
        "sass": "^1.106.1",
        "sharp": "^0.35.5",
        "vite": "^8.3.5",
        "vite-plugin-webfont-dl": "^3.13.1"
    },
    "dependencies": {
        "@alpinejs/mask": "^3.17.5",
        "@floating-ui/dom": "^1.8.0",
        "bootstrap": "6.0.0-alpha.1",
        "clipboard": "^2.0.11",
        "glightbox": "^3.3.1",
        "infinite-scroll": "^5.0.0",
        "plyr": "^3.8.5",
        "share-api-polyfill": "^1.1.1",
        "sweetalert2": "^11.26.25",
        "swiper": "^14.3.0",
        "vanilla-calendar-pro": "^3.4.0",
        "wow.js": "^1.2.2"
    }
}
