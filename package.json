{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "npm run webp && vite",
        "build": "npm run webp && vite build && npm run pwa",
        "webp": "node resources/js/utilities/webp.js",
        "pwa": "node resources/js/utilities/create-manifest.js",
        "lint": "prettier --write resources/",
        "test:lint": "prettier --check resources/",
        "build:filament": "vite build --config vite.admix.config.js"
    },
    "devDependencies": {
        "@erbelion/vite-plugin-laravel-purgecss": "^0.4.8",
        "@tailwindcss/vite": "^4.3.3",
        "concurrently": "^10.0.4",
        "imagemin": "^9.0.1",
        "imagemin-webp": "^8.0.0",
        "laravel-vite-plugin": "^3.2.0",
        "npm-check-updates": "^23.0.2",
        "playwright": "^1.62.1",
        "prettier": "^3.9.6",
        "prettier-plugin-blade": "^3.2.2",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rollup-plugin-critical": "^1.0.18",
        "sass": "^1.102.0",
        "vite": "^8.2.1"
    },
    "dependencies": {
        "@alpinejs/mask": "^3.16.1",
        "axios": "^1.19.0",
        "bootstrap": "^5.3.8",
        "clipboard": "^2.0.11",
        "glightbox": "^3.3.1",
        "infinite-scroll": "^5.0.0",
        "plyr": "^3.8.4",
        "share-api-polyfill": "^1.1.1",
        "sweetalert2": "^11.26.25",
        "swiper": "^14.1.0",
        "tom-select": "^2.6.2",
        "wow.js": "^1.2.2"
    }
}
