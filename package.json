{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "npm run webp && vite",
        "build": "npm run webp && vite build && npm run pwa",
        "webp": "node resources/js/utilities/webp.js",
        "pwa": "node resources/js/utilities/create-manifest.js",
        "lint": "prettier --write resources/",
        "test:lint": "prettier --check resources/",
        "build:filament": "vite build --config vite.admix.config.js",
        "checklist-frontend": "node resources/js/utilities/checklist-frontend.js",
        "postinstall": "playwright install chromium"
    },
    "devDependencies": {
        "@erbelion/vite-plugin-laravel-purgecss": "^0.4.8",
        "@tailwindcss/vite": "^4.3.5",
        "concurrently": "^10.0.7",
        "laravel-vite-plugin": "^3.2.1",
        "lighthouse": "^13.6.0",
        "npm-check-updates": "^23.1.1",
        "playwright": "^1.65.1",
        "prettier": "^3.10.1",
        "prettier-plugin-blade": "^3.3.3",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "rollup-plugin-critical": "^1.0.18",
        "sass": "^1.108.2",
        "sharp": "^0.35.5",
        "vite": "^8.3.8",
        "vite-plugin-webfont-dl": "^3.14.1"
    },
    "dependencies": {
        "@alpinejs/mask": "^3.17.5",
        "bootstrap": "^5.3.9",
        "clipboard": "^2.0.11",
        "glightbox": "^3.3.1",
        "infinite-scroll": "^5.0.0",
        "share-api-polyfill": "^1.1.1",
        "sweetalert2": "^11.26.25",
        "swiper": "^14.4.0",
        "tom-select": "^2.7.0",
        "vlitejs": "^8.1.1",
        "wow.js": "^1.2.2"
    },
    "allowScripts": {
        "@parcel/watcher": false,
        "puppeteer": false
    }
}
